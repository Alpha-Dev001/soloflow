# ─────────────────────────────────────────────────────────────
# SoloFlow — Environment Variables
#
# Copy this file to backend/.env and fill in the values.
# The frontend has NO environment variables — it gets everything
# through the /api proxy to the backend.
# ─────────────────────────────────────────────────────────────

# ── Backend server ────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/soloflow
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/soloflow
MONGODB_URI=mongodb://localhost:27017/soloflow

# ── JWT ───────────────────────────────────────────────────────
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=soloflow-jwt-secret-change-in-production

# ── Google Gemini ─────────────────────────────────────────────
# Required for AI proposal generation and the AI chat assistant.
# Get a free key at: https://aistudio.google.com/app/apikey
# Leave blank to disable AI features (graceful fallback is built in).
GEMINI_API_KEY=
